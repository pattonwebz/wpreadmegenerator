{
  "name": "@pattonwebz/wpreadmegenerator",
  "version": "0.1.0",
  "description": "Generate and validate a WordPress.org plugin readme.txt",
  "type": "module",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=20.19"
  },
  "bin": {
    "wpreadme": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build --silent && node --test test/*.test.js",
    "test:only": "node --test test/*.test.js",
    "test:stress": "node test/stress.mjs"
  },
  "keywords": [
    "wordpress",
    "readme",
    "plugin",
    "validator"
  ],
  "devDependencies": {
    "@types/node": "26.6.4",
    "typescript": "7.0.2"
  }
}
